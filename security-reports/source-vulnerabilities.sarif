            {
              "id": "CVE-2026-64642",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "next: Next.js: Authentication bypass leading to unauthorized access"
              },
              "fullDescription": {
                "text": "Next.js is a React framework for building full-stack web applications. In versions 16.0.0 through 16.2.10, crafted requests targeting Next.js applications using App Router built with Turbopack and a single entry in config.i18n.locales can bypass middleware/proxy based authentication. This issue has been fixed in version 16.2.11."
              },
